# Binaries and build output
bin/
*.exe
*.test

# NOTE: no `dist/` entry here on purpose — dist/ holds tracked packaging
# sources (systemd unit, plan 01-05), not build output.

# goreleaser build output — .goreleaser.yaml redirects dist here so a
# --clean run can never wipe the tracked dist/ packaging sources (04-03).
.goreleaser-dist/

# Test and coverage output
e2e-report.txt
perf-report.txt
switch-spike-report.txt
*.coverprofile
coverage.out
coverage.html

# Tool caches
.cache/
.gocache/
.gomodcache/

# Python bytecode from the e2e AT-SPI helper runs
__pycache__/

# mise local overrides (mise.toml itself is tracked)
.mise.local.toml

# Editors and OS noise
.idea/
.vscode/
*.swp
.DS_Store

# go build output of the e2e stand (go build -o e2e ./test/e2e)
/e2e
/test/e2e/e2e

# scratch `go build` in the repo root (release builds go to dist/, never here)
/goswitchd
.planning/tmp/
.planning/phases/*/evidence-*.log

# local GSD/ZCode runtime state (agents, sentinels, flags — never tracked)
.gsd/
.zcode/
.zcodeignore
.planning/.gsd-allow-shrink
